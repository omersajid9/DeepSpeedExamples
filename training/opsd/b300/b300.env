# PFUSE_* overrides for the B300 box (source this, or use run_smoke.sh /
# run_matrix.sh which source it for you).
# All paths assume the transfer script's layout under $HOME/pfuse.
export PFUSE_BASE="${PFUSE_BASE:-$HOME/pfuse}"
export PFUSE_DS_REPO="$PFUSE_BASE/projects/DeepSpeed"
export PFUSE_OPS_PY="$PFUSE_BASE/conda/envs/opsd/bin/python"
export PFUSE_VLLM_PY="$PFUSE_BASE/conda/envs/vllm33/bin/python"
export PFUSE_SP="$PFUSE_BASE/conda/envs/opsd/lib/python3.12/site-packages"
export PFUSE_MODEL_9B="$PFUSE_BASE/models/Qwen3.5-9B"
# 4B: downloaded from HF on first run (needs internet), or set this to a
# local model dir to use a transferred copy:
# export PFUSE_MODEL_4B="$PFUSE_BASE/models/Qwen3.5-4B"
export PFUSE_HF_HOME="$PFUSE_BASE/hf_cache"
export PFUSE_TORCHINDUCTOR_CACHE="$PFUSE_BASE/torchinductor_cache"
export PFUSE_TORCH_EXTENSIONS="$PFUSE_BASE/torch_extensions"
export PFUSE_TMPDIR="$PFUSE_BASE/tmp_bench"
export PFUSE_VLLM_CACHE="$PFUSE_BASE/vllm_cache"
# CUDA 13.2 nvcc assembled by setup_b300.sh from the PyPI wheels:
export PFUSE_CUDA_HOME="$PFUSE_BASE/cuda-shim"
export PFUSE_NVCC_PATH="$PFUSE_BASE/cuda-shim/bin"
# Host gcc/g++ (Ubuntu):
export PFUSE_CC="$(command -v gcc)"
export PFUSE_CXX="$(command -v g++)"
# The cu13 headers live in the opsd env's nvidia wheels (same layout as Delta):
export PFUSE_CPATH="$PFUSE_SP/nvidia/cu13/include:$PFUSE_SP/nvidia/cu13/include/cccl"
# Matching nvcc + matching headers: the CCCL compat flag is not needed,
# but harmless; keep it to stay byte-compatible with the Delta runs.
export PFUSE_FLASHINFER_FLAGS="-DCCCL_DISABLE_CTK_COMPATIBILITY_CHECK"
# Which GPU to use (default: 0 of the 8 B300s):
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
